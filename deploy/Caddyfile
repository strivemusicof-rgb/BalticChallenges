vps-1a18ee51.vps.ovh.net {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	handle_path /uploads/* {
		root * /var/lib/baltic-challenges/uploads
		header Cache-Control "public, max-age=604800, immutable"
		file_server
	}

	redir /admin /admin/ 308

	handle_path /admin/* {
		root * /opt/baltic-challenges/current/admin
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	redir /app /app/ 308

	handle_path /app/* {
		root * /opt/baltic-challenges/current/web
		header /_expo/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}

	handle {
		reverse_proxy 127.0.0.1:4000
	}
}
